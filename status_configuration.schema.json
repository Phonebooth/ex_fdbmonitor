{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "FoundationDB Status",
    "description": "JSON schema for FoundationDB status JSON.",
    "type": "object",
    "properties": {
        "cluster": {
            "type": "object",
            "properties": {
                "configuration": {
                    "type": "object",
                    "properties": {
                        "redundancy_mode": {
                            "type": "string",
                            "enum": [
                                "single",
                                "double",
                                "triple",
                                "three_data_hall",
                                "three_data_hall_fallback"
                            ]
                        },
                        "storage_engine": {
                            "type": "string",
                            "enum": [
                                "ssd",
                                "ssd-1",
                                "ssd-2",
                                "ssd-redwood-1",
                                "ssd-rocksdb-v1",
                                "ssd-sharded-rocksdb",
                                "memory",
                                "memory-1",
                                "memory-2",
                                "memory-radixtree"
                            ]
                        },
                        "coordinators_count": {
                            "type": "integer"
                        },
                        "excluded_servers": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "address": {
                                        "type": "string"
                                    },
                                    "time": {
                                        "type": "number"
                                    }
                                },
                                "required": [
                                    "address"
                                ]
                            }
                        },
                        "regions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "datacenters": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "priority": {
                                                    "type": "integer"
                                                },
                                                "satellite_logs": {
                                                    "type": "integer"
                                                },
                                                "satellites": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "id": {
                                                                "type": "string"
                                                            },
                                                            "priority": {
                                                                "type": "integer"
                                                            },
                                                            "satellite_logs": {
                                                                "type": "integer"
                                                            }
                                                        },
                                                        "required": [
                                                            "id"
                                                        ]
                                                    }
                                                }
                                            },
                                            "required": [
                                                "id"
                                            ]
                                        }
                                    },
                                    "satellite_redundancy_mode": {
                                        "type": "string",
                                        "enum": [
                                            "one_satellite_single",
                                            "one_satellite_double",
                                            "two_satellite_safe",
                                            "two_satellite_fast"
                                        ]
                                    },
                                    "satellite_log_replicas": {
                                        "type": "integer"
                                    },
                                    "satellite_usable_dcs": {
                                        "type": "integer"
                                    }
                                }
                            }
                        },
                        "usable_regions": {
                            "type": "integer"
                        },
                        "log_version": {
                            "type": "integer"
                        },
                        "log_spill": {
                            "type": "integer"
                        },
                        "logs": {
                            "type": "integer"
                        },
                        "log_engine": {
                            "type": "string",
                            "enum": [
                                "ssd",
                                "ssd-1",
                                "ssd-2",
                                "ssd-redwood-1",
                                "ssd-rocksdb-v1",
                                "ssd-sharded-rocksdb",
                                "memory",
                                "memory-1",
                                "memory-2",
                                "memory-radixtree"
                            ]
                        },
                        "remote_log_engine": {
                            "type": "string",
                            "enum": [
                                "ssd",
                                "memory"
                            ]
                        },
                        "log_replicas": {
                            "type": "integer"
                        },
                        "remote_log_replicas": {
                            "type": "integer"
                        },
                        "log_anti_quorum": {
                            "type": "integer"
                        },
                        "storage_replicas": {
                            "type": "integer"
                        },
                        "commit_proxies": {
                            "type": "integer"
                        },
                        "grv_proxies": {
                            "type": "integer"
                        },
                        "proxies": {
                            "type": "integer"
                        },
                        "resolvers": {
                            "type": "integer"
                        },
                        "backup_worker_enabled": {
                            "type": "integer"
                        },
                        "perpetual_storage_wiggle": {
                            "type": "integer"
                        },
                        "perpetual_storage_wiggle_locality": {
                            "type": "string"
                        },
                        "perpetual_storage_wiggle_engine": {
                            "type": "string",
                            "enum": [
                                "ssd",
                                "ssd-1",
                                "ssd-2",
                                "ssd-redwood-1",
                                "ssd-rocksdb-v1",
                                "ssd-sharded-rocksdb",
                                "memory",
                                "memory-1",
                                "memory-2",
                                "memory-radixtree-beta",
                                "none"
                            ]
                        },
                        "storage_migration_type": {
                            "type": "string",
                            "enum": [
                                "disabled",
                                "aggressive",
                                "gradual"
                            ]
                        },
                        "tenant_mode": {
                            "type": "string",
                            "enum": [
                                "disabled",
                                "optional_experimental",
                                "required_experimental"
                            ]
                        },
                        "blob_granules_enabled": {
                            "type": "integer"
                        },
                        "encryption_at_rest_mode": {
                            "type": "string",
                            "enum": [
                                "disabled",
                                "domain_aware",
                                "cluster_aware"
                            ]
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": true
        },
        "client": {
            "type": "object",
            "properties": {
                "coordinators": {
                    "type": "object",
                    "properties": {
                        "coordinators": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "reachable": {
                                        "type": "boolean"
                                    },
                                    "address": {
                                        "type": "string"
                                    },
                                    "protocol": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "reachable",
                                    "address",
                                    "protocol"
                                ]
                            }
                        },
                        "quorum_reachable": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "coordinators",
                        "quorum_reachable"
                    ]
                },
                "database_status": {
                    "type": "object",
                    "properties": {
                        "available": {
                            "type": "boolean"
                        },
                        "healthy": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "available",
                        "healthy"
                    ]
                },
                "messages": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "enum": [
                                    "inconsistent_cluster_file",
                                    "unreachable_cluster_controller",
                                    "no_cluster_controller",
                                    "status_incomplete_client",
                                    "status_incomplete_coordinators",
                                    "status_incomplete_error",
                                    "status_incomplete_timeout",
                                    "status_incomplete_cluster",
                                    "quorum_not_reachable"
                                ]
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "name",
                            "description"
                        ]
                    }
                },
                "timestamp": {
                    "type": "integer"
                },
                "cluster_file": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "up_to_date": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "path",
                        "up_to_date"
                    ]
                }
            },
            "required": [
                "coordinators",
                "database_status",
                "messages",
                "timestamp",
                "cluster_file"
            ]
        }
    },
    "required": [
        "cluster"
    ],
    "additionalProperties": false
}
